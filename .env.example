# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Web Search Configuration (duckduckgo, tavily, or mock)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Application Settings
FLASK_SECRET_KEY=change-this-in-production-to-a-secure-random-key
FLASK_PORT=5000
FLASK_DEBUG=false
UPLOAD_MAX_FILE_SIZE_MB=25
WORKFLOW_TIMEOUT_SECONDS=300

# Academic Writer & Evaluation Settings
DEFAULT_CITATION_STYLE=IEEE
MAX_CORRECTION_ATTEMPTS=3
EVALUATION_PASSING_SCORE=75.0
